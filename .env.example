# Origem da Core, sem /api/v1 no final. Configurar em .env.local.
# Exemplo de desenvolvimento: http://localhost:8080
VITE_API_BASE_URL=

# Operação, dashboard e consultas administrativas aguardam controllers/DTOs reais.
# Registrar adaptadores tipados em src/services/adminGateway.ts após homologação.
# Não colocar credenciais do banco, JWT, refresh token ou chaves privadas em VITE_*.

# Demonstração solicitada pelo usuário. Somente localhost/127.0.0.1; bloqueia chamadas à Core.
VITE_LOCAL_ADMIN_DEMO=false
