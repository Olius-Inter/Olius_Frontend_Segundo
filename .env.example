# Origem pública da API, sem /api/v1 no final.
# Defina em .env.local no desenvolvimento e nas variáveis do Render na publicação.
VITE_API_BASE_URL=

# Demonstração optativa, disponível somente em localhost/127.0.0.1.
VITE_LOCAL_ADMIN_DEMO=false

# Variáveis VITE_* são públicas. Nunca inclua senhas, tokens ou segredos nelas.
